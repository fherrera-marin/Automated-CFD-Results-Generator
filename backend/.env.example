# Copy this file to <repo root>/.env and fill in the machine-specific paths.
# See docs/operations.md for details on each one.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
REDIS_URL=redis://localhost:6379/0

# Where generated simulation runs live. Defaults to <repo>/data/runs.
# SIM_BASE_DIR=D:/cfd-data/runs

# Template OpenFOAM case directory copied into every generated case.
# data/templates/naca_airfoil_2d/ ships a minimal working simpleFoam +
# snappyHexMesh 2D case to start from -- tune its boundary conditions, mesh
# resolution, etc. for your own research needs.
SIM_ORIGIN_DIR=D:/path/to/repo/data/templates/naca_airfoil_2d

# Script that activates the BlueCFD OpenFOAM environment for this machine
# (puts blockMesh/snappyHexMesh/potentialFoam/simpleFoam/surfaceFeatures on
# PATH). Required before the "openfoam" stage can run.
OPENFOAM_ENV_SCRIPT=

# pvbatch executable from this machine's ParaView installation. Required
# before the "paraview_export" stage can run.
PVBATCH_BIN=

FOAMTOVTK_BIN=foamtoVTK
